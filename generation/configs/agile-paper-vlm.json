{
  "image": {
    "provider": "gemini",
    "model": null,
    "api_key_env": "AGILE_IMAGE_API_KEY",
    "api": "generate_content"
  },
  "mesh": {
    "backend": "hunyuan",
    "python": "/ABS/HUNYUAN_ENV/bin/python",
    "repository": "/ABS/Hunyuan3D-2",
    "shape_model": null,
    "subfolder": null,
    "texture_model": null
  },
  "quality": {
    "max_attempts": 3,
    "min_score": 7,
    "require_texture": true
  },
  "surface": {
    "enabled": true,
    "executable": "blender",
    "method": "quadriflow",
    "target_faces": 10000,
    "texture_size": 1024,
    "geometry_review": true,
    "uv_method": "smart_project"
  },
  "texture": {
    "provider": "image_api",
    "layout": "mesh_uv"
  },
  "agent": {
    "backend": "vlm",
    "base_url": "https://YOUR_VLM_ENDPOINT/v1",
    "model": "YOUR_VISION_MODEL",
    "api_key_env": "AGILE_VLM_API_KEY",
    "response_format": "json_schema",
    "max_retries": 0,
    "max_output_tokens": 4096,
    "timeout_seconds": 600,
    "review_context": "images_only"
  },
  "generation": {
    "require_selection": true,
    "multiview_review": true,
    "texture_review": true,
    "max_multiview_attempts": 3,
    "multiview_fallback": "stop",
    "fallback_max_views": 3,
    "max_texture_attempts": 3,
    "min_multiview_score": 7.0,
    "min_texture_score": 7.0
  }
}
